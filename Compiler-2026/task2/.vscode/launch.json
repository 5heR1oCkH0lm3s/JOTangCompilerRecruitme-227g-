{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试中端 (-O1)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/compiler_middle_end",
      "args": ["${workspaceFolder}/input.sy", "-S", "-o", "${workspaceFolder}/output.ll", "-O1"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        { "description": "启用整齐打印", "text": "-enable-pretty-printing", "ignoreFailures": true },
        { "description": "反汇编使用 Intel 风格", "text": "-gdb-set disassembly-flavor intel", "ignoreFailures": true }
      ],
      "preLaunchTask": "build-middle-end"
    },
    {
      "name": "调试中端 (-O0)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/compiler_middle_end",
      "args": ["${workspaceFolder}/input.sy", "-S", "-o", "${workspaceFolder}/output.ll", "-O0"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        { "description": "启用整齐打印", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ],
      "preLaunchTask": "build-middle-end"
    },
    {
      "name": "调试当前打开的 .sy (-O1)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/compiler_middle_end",
      "args": ["${file}", "-S", "-o", "${workspaceFolder}/output.ll", "-O1"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        { "description": "启用整齐打印", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ],
      "preLaunchTask": "build-middle-end"
    }
  ]
}